{
  "name": "subscription-payments",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first subscription tracker: renewal dates, costs and credentials stay on your device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/build-brand-icons.mjs",
    "android:sync": "npm run build:native && cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "simple-icons": "^16.37.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
